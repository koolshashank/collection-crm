# ══════════════════════════════════════════════════════════════
# WHITE-LABELING: to run this CRM for a different company, every
# backend host and branding string below is env-driven — you should
# not need to edit any source file. Start here.
# ══════════════════════════════════════════════════════════════

# ── Backend hosts (all four are used by different parts of the app) ──
# 1. Main CRM backend — login, client details, PTP, payments, docs, NOC…
CRM_API_BASE_URL=https://backend.blinkrloan.com/api/

# 2. LoanSphere service — admin dashboard summary, lead logs
LOANSPHERE_API_BASE_URL=https://api.blinkrloan.com/api/loansphere/

# 3. PayTracker service — loan portfolio list (Leads, Team Performance)
PAYTRACKER_API_BASE_URL=https://api.blinkrloan.com/api/paytracker/v1/

# 4. ⚠️ PayTracker DEV host — three dashboard widgets (top-performers,
#    portfolio-summary, portfolio-summary-list) were hardcoded to the DEV
#    server in the original code, not production. Left as-is so their
#    behaviour doesn't change silently; point this at the production host
#    once the team confirms that's correct.
PAYTRACKER_DEV_API_BASE_URL=https://dev.api.blinkrloan.com/api/paytracker/v1/

# Public URL of this CRM itself (used for links pointing back at the app)
CRM_PUBLIC_BASE_URL=https://crm.blinkrloan.com

# ── Branding ─────────────────────────────────────────────────
# Footer line printed on generated NOC PDFs
# NOC_FOOTER_TEXT=RBI Registered NBFC | +91-8595333222 | Info@blinkrloan.com

# ── Legacy PHP fallback ───────────────────────────────────────
# A few endpoints (process_assign.php, bulkAssignProcess.php, submit_ptp.php,
# submit_remarks.php, submit_disposition.php, block_pan_action.php,
# enable_reloan.php, post-payment-api.php, get_lead_pan.php,
# loan_history_proxy.php, assign_field.php, loan_correction_proxy.php,
# settlement_action.php [non get_emp_list actions]) were referenced by the UI
# but their PHP source was NOT in the migration bundle.
# Set this to your old PHP deployment and those calls will be proxied 1:1.
# Leave unset → those routes return a clear 501 JSON message.
# LEGACY_PHP_BASE_URL=https://crm.blinkrloan.com

# ── Dootiq / WhatsApp ────────────────────────────────────────
# Defaults inside lib/whatsapp/dootiq.js are the values from the PHP source.
# DOOTIQ_BASE_URL=
# DOOTIQ_CLIENT_ID=
# DOOTIQ_CLIENT_SECRET=

# ── ConVox telephony ─────────────────────────────────────────
# Defaults inside lib/convox.js are the values from the PHP source.
# CONVOX_USER_ID_MAP={"agent@blinkrloan.com":"1001"}
# CONVOX_USER_LOCATION_MAP={"agent@blinkrloan.com":"blinkrloan.deepijatel.in"}

# ── NOC email (SMTP) ─────────────────────────────────────────
# Defaults = PHP noc_email.php values (Netcore SMTP).
# NOC_SMTP_HOST=smtp.netcorecloud.net
# NOC_SMTP_PORT=587
# NOC_SMTP_USER=
# NOC_SMTP_PASS=
# NOC_MAIL_FROM=
# NOC_MAIL_FROM_NAME=
# NOC_MAIL_REPLY_TO=

# ── S3 uploads ───────────────────────────────────────────────
# Defaults inside lib/s3.js are the values from includes/s3_uploader.php.
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Zoho Mail (Mail module proxies) ──────────────────────────
# ZOHO_TOKENS_FILE=./zoho_tokens.json
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=

# ── Misc ─────────────────────────────────────────────────────
# Public URL of this app (used for logout redirects)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Override for the paytracker API base used by the leads list
# PAYTRACKER_API_BASE_URL=https://api.blinkrloan.com/api/paytracker/v1/portfolio

# ── ConVox call-status storage (backend API, once provided) ──
# Set these once the team gives you the API that stores call data in the DB.
# Until CALL_STATUS_STORE_API_URL is set, the webhook falls back to local
# JSON files under data/call_status_logs/ automatically — nothing breaks.
CALL_STATUS_STORE_API_URL=
CALL_STATUS_STORE_API_KEY=

# ── Payment gateways ─────────────────────────────────────────
# Defaults are the values from the PHP source.
# PAYTM_LINK_URL=https://api.blinkrloan.com/api/paytracker/v1/payment/generate-payment-link-paytm
# PAYTM_SUCCESS_URL=https://api.blinkrloan.com/success
# PAYTM_FAILURE_URL=https://api.blinkrloan.com/failure
# PAYU_LINK_URL=https://backend.blinkrloan.com/api/collection/generate-payment-link-payu
